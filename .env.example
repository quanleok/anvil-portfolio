# Local development media storage. Keep secrets in .env.local, not here.
ANVIL_MEDIA_STORAGE=local-dev
ANVIL_PROJECT_STORE=local
ANVIL_MAX_UPLOAD_BYTES=104857600
ANVIL_API_TOKEN=
ANVIL_SIGNING_SECRET=
ANVIL_ALLOWED_EMAILS=

# Protected Anvil server lane. Required for Anvil-owned methods, private
# recipes, hosted LLM calls, and hosted provider keys. Never put provider keys
# in the desktop app.
ANVIL_ENABLE_PROTECTED_METHODS=1
ANVIL_SERVER_API_TOKEN=
ANVIL_SERVER_LLM_PROVIDER=mock
# ANVIL_SERVER_LLM_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Desktop -> protected server bridge for local testing.
# Keep disabled unless testing protected methods from Electron.
# ANVIL_ENABLE_PROTECTED_ANVIL_CLIENT=1
# ANVIL_PROTECTED_ANVIL_URL=http://localhost:3000/api/anvil/turn
# ANVIL_PROTECTED_ANVIL_TOKEN=

# Stripe Billing is dormant by default while the local app stabilizes. When
# reactivated, the paid product is one Anvil License at $100/year.
ANVIL_ENABLE_BILLING_API=0
# STRIPE_SECRET_KEY=
# ANVIL_STRIPE_MEMBERSHIP_PRICE_ID=price_... # $100/year Anvil License
# Backwards-compatible alias if production still uses the old env name:
# ANVIL_STRIPE_PRO_PRICE_ID=price_...
# ANVIL_MEMBERSHIP_TRIAL_DAYS=7
# ANVIL_AUTO_START_MEMBERSHIP_TRIAL=0
# Optional public payment-link fallback when STRIPE_SECRET_KEY is not set.
# ANVIL_STRIPE_MEMBERSHIP_PAYMENT_LINK=https://buy.stripe.com/...
# Backwards-compatible alias if production still uses the old env name:
# ANVIL_STRIPE_PRO_PAYMENT_LINK=https://buy.stripe.com/...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Set both app URLs to the same public origin in production.
# Production launch value: https://www.myriadanvil.com
# ANVIL_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Free launch has bounded hosted-agent usage by default. Require Supabase usage
# ledger writes only after billing + usage migrations are applied.
# ANVIL_USAGE_REQUIRE_LEDGER=1
# Trial caps are for future license testing only.
# ANVIL_TRIAL_USAGE_LIMITS_JSON={"monthlyEvents":50,"monthlyTokens":150000,"monthlyCostUsd":1.5,"concurrency":1}
# ANVIL_USAGE_LIMITS_JSON={"pro":{"monthlyEvents":300,"concurrency":1,"monthlyCostUsd":8}}
# ANVIL_MODEL_PRICING_JSON={"*":{"inputPerMillionUsd":3,"outputPerMillionUsd":15}}

# Production smoke test. Defaults to https://www.myriadanvil.com.
# ANVIL_SMOKE_BASE_URL=https://www.myriadanvil.com
# ANVIL_SMOKE_TIMEOUT_MS=120000

# Hosted Anvil agent / protected method API. This is the server-side IP
# boundary for Anvil-owned methods and private recipes.
ANVIL_ENABLE_ANVIL_AGENT=1
ANVIL_AGENT_SERVER_TOKEN=
# Optional: maps server-token calls to a paid Supabase owner UUID.
# Without this, production server-token calls authenticate without a persisted owner.
# ANVIL_AGENT_TOKEN_OWNER_ID=
ANVIL_AGENT_PROVIDER=anthropic
# ANVIL_AGENT_MODEL=claude-sonnet-4-6

# Supabase project metadata store for deployed browser/API builds.
# Keep service-role keys server-only. Never expose them with NEXT_PUBLIC_.
# Supabase Auth should have Google enabled for launch login. Configure Google
# OAuth in the Supabase dashboard; the app callback route is /auth/callback.
# ANVIL_PROJECT_STORE=supabase
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Bunny media storage for deployed browser/API builds.
# Use the storage-zone password/access key, not the global Bunny account API key.
# ANVIL_MEDIA_STORAGE=bunny
# ANVIL_MEDIA_SIGNING_SECRET=
# BUNNY_STORAGE_ZONE=anvil
# BUNNY_STORAGE_ACCESS_KEY=
# Optional region shorthand, or set BUNNY_STORAGE_ENDPOINT=https://la.storage.bunnycdn.com
# BUNNY_STORAGE_REGION=la
# BUNNY_STORAGE_ENDPOINT=
# BUNNY_CDN_BASE_URL=https://anvilpullzone.b-cdn.net
# BUNNY_CDN_HOSTNAME=anvilpullzone.b-cdn.net
# BUNNY_CDN_TOKEN_AUTH_KEY=
# Optional upload boundaries in megabytes.
# ANVIL_MEDIA_IMAGE_MAX_MB=50
# ANVIL_MEDIA_VIDEO_MAX_MB=51200
# ANVIL_MEDIA_AUDIO_MAX_MB=2048

# Installer downloads are served through /downloads/[file] signed redirects to
# Bunny objects. Keep large installer binaries out of Vercel static files.
# scripts/stage-macos-download.mjs uploads a versioned object and the public
# route redirects /downloads/forge-macos-arm64.dmg to that object. Versioned
# object names avoid stale CDN range chunks on installer replacement.
# ANVIL_MACOS_ARM64_DMG_OBJECT_KEY=downloads/forge-macos-arm64-0.2.2-clean.dmg
# Set ANVIL_STAGE_LOCAL_DOWNLOADS=1 only for local file-server testing.

# macOS public distribution requires Apple Developer ID signing + notarization.
# npm run package:mac now blocks unless these are configured, so an ad-hoc DMG
# cannot be uploaded to the public download route by accident.
# Install a "Developer ID Application" certificate in Keychain, then configure
# one notarization credential strategy:
# Strategy A: stored notarytool profile
# APPLE_KEYCHAIN_PROFILE=anvil-notary
# APPLE_KEYCHAIN=
# Strategy B: Apple ID app-specific password
# APPLE_ID=apple-id@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=TEAMID1234
# Strategy C: App Store Connect API key
# APPLE_API_KEY=/absolute/path/AuthKey_XXXXXX.p8
# APPLE_API_KEY_ID=XXXXXX
# APPLE_API_ISSUER=00000000-0000-0000-0000-000000000000
